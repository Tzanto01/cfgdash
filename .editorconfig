root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cs,csproj,props,targets,ps1,slnx,xaml}]
indent_style = space
indent_size = 4
end_of_line = crlf

[*.{json,jsonc,yml,yaml,md,html,css,scss,ts,js}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
